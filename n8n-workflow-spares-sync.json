    {
      "parameters": {
        "jsCode": "const esc = v => {\n  v = String(v ?? '');\n  return /[;\"\\n\\r]/.test(v) ? '\"' + v.replace(/\"/g, '\"\"') + '\"' : v;\n};\nconst lines = $input.all().map(i => {\n  const r = i.json;\n  return [r.spare_code, r.spare_name, r.spare_description, r.spare_type,\n          r.spare_status, r.price, r.quantity, r.updated_at].map(esc).join(';');\n});\nreturn [{ json: { csv: lines.join('\\n'), rows: lines.length } }];"
      },
