    {
      "parameters": {
        "operation": "executeQuery",
        "query": "CREATE TABLE IF NOT EXISTS spares (\n  spare_code        text PRIMARY KEY,\n  spare_name        text,\n  spare_description text,\n  spare_type        text,\n  spare_status      text,\n  price             text,\n  quantity          integer,\n  updated_at        text,\n  first_seen_at     timestamptz DEFAULT now(),\n  last_seen_at      timestamptz,\n  is_active         boolean DEFAULT true\n);",
        "options": {}
      },
      "name": "Create Table",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        448,
        0
      ],
      "executeOnce": true,
      "alwaysOutputData": true,
      "id": "1db1b985-9da6-44f4-bc9b-eb12474e9916",
      "credentials": {
        "postgres": {
          "id": "wCBhNZY6XsRDKwQT",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst base = cfg.baseUrl.replace(/\\/$/, '');\nconst startedAt = new Date().toISOString();\nlet token = null;\nlet lastErr = null;\n// В описании API указан /auth/login, в Swagger виден /auth/token - пробуем оба\nfor (const path of ['/auth/login', '/auth/token']) {\n  try {\n    const res = await this.helpers.httpRequest({\n      method: 'POST',\n      url: base + path,\n      body: { username: cfg.username, password: cfg.password },\n      json: true,\n    });\n    if (res && res.token) { token = res.token; break; }\n  } catch (e) { lastErr = e; }\n}\nif (!token) {\n  throw new Error('Не удалось получить токен: ' + (lastErr ? lastErr.message : 'пустой ответ'));\n}\nreturn [{ json: { token, startedAt } }];"
      },
      "name": "Login",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "id": "02df5ca3-3285-4a14-8634-18e34f8018ca"
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst { token, startedAt } = $('Login').first().json;\nconst base = cfg.baseUrl.replace(/\\/$/, '');\nconst SIZE = 10;\n\nconst basic = 'Basic ' + Buffer.from(cfg.username + ':' + cfg.password).toString('base64');\nconst toArr = d => Array.isArray(d) ? d : (d && Array.isArray(d.content) ? d.content : []);\nconst get = (authHeader, page) => this.helpers.httpRequest({\n  method: 'GET',\n  url: base + '/cms/spares',\n  qs: { page, size: SIZE },\n  headers: { Authorization: authHeader },\n  json: true,\n});\n\n// CMS защищён BasicAuth; если вдруг не пустит - пробуем Bearer-токен\nlet auth = basic;\nlet data;\ntry {\n  data = toArr(await get(auth, 0));\n} catch (e) {\n  auth = 'Bearer ' + token;\n  data = toArr(await get(auth, 0));\n}\n\nconst all = [];\nlet page = 0;\nwhile (data.length > 0) {\n  all.push(...data);\n  page++;\n  if (page > 2000) throw new Error('Слишком много страниц, остановка');\n  data = toArr(await get(auth, page));\n}\n\n// Защита: пустая выгрузка не должна привести к пометке всех деталей неактивными\nif (all.length === 0) {\n  throw new Error('CMS вернул 0 деталей - синхронизация прервана');\n}\n\n// Убираем дубли по коду (побеждает последняя запись)\nconst byCode = new Map();\nfor (const s of all) byCode.set(s.spareCode, s);\n\nreturn [...byCode.values()].map(s => ({ json: {\n  spare_code: s.spareCode,\n  spare_name: s.spareName ?? null,\n  spare_description: s.spareDescription ?? null,\n  spare_type: s.spareType ?? null,\n  spare_status: s.spareStatus ?? null,\n  price: s.price == null ? null : String(s.price),\n  quantity: s.quantity ?? null,\n  updated_at: s.updatedAt ?? null,\n  last_seen_at: startedAt,\n  is_active: true,\n}}));"
      },
